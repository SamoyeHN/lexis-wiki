{
  "type": "object",
  "properties": {
    "quiz_title": {
      "type": "string",
      "minLength": 1
    },
    "overall_quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "pass_audit": {
      "type": "boolean"
    },
    "blind_solve_accuracy": {
      "type": "number"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_index": {
            "type": "integer"
          },
          "blind_solved_index": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "Definite",
              "Hesitant",
              "Ambiguous"
            ]
          },
          "single_fit_valid": {
            "type": "boolean"
          },
          "distractors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "option_letter": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "option_text": {
                  "type": "string",
                  "minLength": 1
                },
                "trap_type": {
                  "type": "string",
                  "enum": [
                    "None (Correct Answer)",
                    "Antonym / Logical Polarity Clash",
                    "Collocation / Preposition Clash",
                    "Domain / Category Mismatch",
                    "L1 Negative Transfer / False Friend",
                    "Scope Shift / Over-generalization",
                    "Speaker / Entity Misattribution",
                    "Chronological / Causal Inversion",
                    "Plausible Real-World Distractor",
                    "Flawed / Trivial Giveaway"
                  ]
                },
                "plausibility_rating": {
                  "type": "string",
                  "enum": [
                    "High",
                    "Medium",
                    "Low (Flawed)"
                  ]
                },
                "elimination_rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "option_letter",
                "option_text",
                "trap_type",
                "plausibility_rating",
                "elimination_rationale"
              ],
              "additionalProperties": false
            }
          },
          "pedagogical_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "diagnostic_feedback": {
            "type": "string",
            "minLength": 1
          },
          "triage_action": {
            "type": "string",
            "enum": [
              "PASS",
              "REPAIR",
              "REWRITE"
            ]
          },
          "cured_question": {
            "type": ["object", "null"],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "correct_answer_index": {
                "type": "integer",
                "enum": [0, 1, 2, 3]
              },
              "category": {
                "type": "string",
                "enum": [
                  "Main Idea",
                  "Detail/Recall",
                  "Inference",
                  "Author's Tone/Purpose"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question",
              "options",
              "correct_answer_index",
              "category",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "item_index",
          "blind_solved_index",
          "confidence",
          "single_fit_valid",
          "distractors",
          "pedagogical_score",
          "diagnostic_feedback",
          "triage_action"
        ],
        "additionalProperties": false
      }
    },
    "summary_verdict": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "quiz_title",
    "overall_quality_score",
    "pass_audit",
    "blind_solve_accuracy",
    "questions",
    "summary_verdict"
  ],
  "additionalProperties": false
}