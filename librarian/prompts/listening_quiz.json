        "type": "object",
        "properties": {
          "speaker": {
            "type": "string",
            "enum": [
              "{speaker_1_name}",
              "{speaker_2_name}"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
