              "minLength": 1
            }
          },
          "correct_answer_index": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "Detail",
              "Main Idea",
              "Inference"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "design_audit",
          "question",
          "options",
          "correct_answer_index",
          "category",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
