      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "speaker_1": {
      "type": "string",
      "enum": [
        "{speaker_1_name}"
      ]
    },
    "speaker_2": {
      "type": "string",
      "enum": [
        "{speaker_2_name}"
      ]
    },
    "speaker_1_gender": {
      "type": "string",
      "enum": [
        "{speaker_1_gender}"
      ]
    },
    "speaker_2_gender": {
      "type": "string",
      "enum": [
        "{speaker_2_gender}"
      ]
    },
    "speaker_1_role": {
      "type": "string",
      "minLength": 1
    },
    "speaker_2_role": {
      "type": "string",
      "minLength": 1
    },
    "speaker_1_accent": {
      "type": "string",
      "enum": [
        "{speaker_1_accent}"
      ]
    },
    "speaker_2_accent": {
      "type": "string",
      "enum": [
        "{speaker_2_accent}"
      ]
    },
    "script": {
      "type": "array",
