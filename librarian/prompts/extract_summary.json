          "concept_name": {
            "type": "string",
            "minLength": 1
          },
          "educational_significance": {
            "type": "string",
            "minLength": 1
          },
          "key_details": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "related_connections": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          }
        },
        "required": [
          "concept_name",
          "educational_significance",
          "key_details",
          "related_connections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "text_summary_or_plot",
    "estimated_reading_time",
    "essential_questions",
