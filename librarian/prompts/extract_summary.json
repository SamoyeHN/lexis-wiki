{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text_summary_or_plot": {
      "type": "string",
      "minLength": 1
    },
    "estimated_reading_time": {
      "type": "string",
      "minLength": 1
    },
    "essential_questions": {
