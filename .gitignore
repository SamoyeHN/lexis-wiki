# Python artifacts
__pycache__/
*.py[cod]
*.class
*.egg-info/
dist/
build/
.venv/
env/
venv/

# Environment and IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scripts and test files
scripts/

# Lexicon databases and their snapshots - hundreds of MB each, rebuilt by
# scripts/build_ldoce_db.py, never committed
*.db
*.db.bak*

# Execution logs
logs/
*.log

# Exclude all user wiki content (users generate their own units via 'lexis init' / 'lexis compile')
wiki/

# Exclude config json
wiki_config.json

# Lexical source archives (keep compiled json only)
scratch/

# Throwaway diagnostic scripts and their captured output
scratchs/